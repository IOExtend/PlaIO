<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Turns Archicad containers read by PlaIO into IOScene scene documents. Unpublished while the reader decodes only the container; it ships when elements and geometry are read.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The adapter trigger of the target architecture: it becomes packable and ships on a PlaIO tag when the reader
         decodes elements and geometry. Until then nothing publishes, so no consumer can build on an empty mapping. -->
    <IsPackable>false</IsPackable>
    <!-- IOScene is referenced by a range whose upper bound is a prerelease ([0.N.0, 0.N+1.0-0.0)); NU5104 is expected. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaIO\PlaIO.csproj" />
    <PackageReference Include="IOScene" />
  </ItemGroup>

  <!-- The shared pack metadata expects icon.png beside the project; the adapter ships the engine's icon. -->
  <ItemGroup>
    <None Remove="$(MSBuildProjectDirectory)/icon.png" />
    <None Include="..\PlaIO\icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Adapter and engine ship on one tag, so the packed engine dependency is exact [X.Y.Z], not >=; a mix gives NU1608. -->
  <Target Name="PinProjectReferencesExactly" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_Pinned Include="@(_ProjectReferencesWithVersions)"><ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion></_Pinned>
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_Pinned)" />
    </ItemGroup>
  </Target>

</Project>

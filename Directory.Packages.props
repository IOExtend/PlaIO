<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Runtime dependencies of the library: none. See docs/dependencies.md. -->

  <ItemGroup>
    <!-- Grid paths require IOScene 0.1.2. Keep the upper bound below previews of the next minor. -->
    <PackageVersion Include="IOScene" Version="[0.1.2, 0.2.0-0.0)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only packages, pinned to exact versions (no floating ranges). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
